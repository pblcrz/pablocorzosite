---
/**
 * Compact "Part of this idea" line — sits inline in the article meta bar,
 * naming the central idea and linking to it. Kept to one line; the idea's
 * statement is deliberately omitted here.
 */
import { getSiteGraph } from '../utils/site-graph';

interface Props {
  artifactSlug: string;
}

const { artifactSlug } = Astro.props;
const { artifactsBySlug, ideasBySlug } = await getSiteGraph();

const artifact = artifactsBySlug.get(artifactSlug);
const idea = artifact?.primaryIdea ? ideasBySlug.get(artifact.primaryIdea) : undefined;
---

{
  idea && (
    <p class="t-label text-dim">
      Part of this idea:{' '}
      <a
        href={`/ideas/${idea.slug}`}
        class="text-accent-text no-underline transition-colors hover:text-foreground"
      >
        {idea.title}
      </a>
    </p>
  )
}
