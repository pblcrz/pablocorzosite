---
/**
 * The article footer: a quiet, distinct "related reading" zone set apart from
 * the article body by a surface band, small labels, and compact type.
 *
 * "More on this idea": other artifacts sharing the primary idea.
 * "Continue the idea": explicit artifact relationships (both directions) and
 *     the primary idea's connected ideas, each with a relationship label.
 */
import type { ThreadItem } from './ConnectionThread.astro';
import {
  inverseRelationshipLabels,
  relationshipLabels,
  type ArtifactNode,
} from '../utils/content-graph';
import { getSiteGraph } from '../utils/site-graph';

interface Props {
  artifactSlug: string;
}

const { artifactSlug } = Astro.props;
const { artifactsBySlug, ideasBySlug } = await getSiteGraph();
const artifact = artifactsBySlug.get(artifactSlug);

const idea = artifact?.primaryIdea ? ideasBySlug.get(artifact.primaryIdea) : undefined;

// --- Module B --------------------------------------------------------------
const sameIdea: ArtifactNode[] = (artifact?.sameIdeaArtifacts ?? [])
  .map((slug) => artifactsBySlug.get(slug))
  .filter((node): node is ArtifactNode => Boolean(node));

// --- Module C --------------------------------------------------------------
const threadItems: ThreadItem[] = [
  // Explicit artifact relationships, both directions.
  ...(artifact?.relationships ?? []).flatMap((relationship) => {
    const target = artifactsBySlug.get(relationship.target);
    return target
      ? [{
          label: relationshipLabels[relationship.type],
          href: `/writing/${target.slug}`,
          title: target.title,
          note: relationship.note,
          meta: target.kind,
          draft: target.draft,
        }]
      : [];
  }),
  ...(artifact?.incomingRelationships ?? []).flatMap((incoming) => {
    const source = artifactsBySlug.get(incoming.source);
    return source
      ? [{
          label: inverseRelationshipLabels[incoming.type],
          href: `/writing/${source.slug}`,
          title: source.title,
          note: incoming.note,
          meta: source.kind,
          draft: source.draft,
        }]
      : [];
  }),
  // The primary idea's connections, both directions.
  ...(idea?.connections ?? []).flatMap((connection) => {
    const target = ideasBySlug.get(connection.target);
    return target
      ? [{
          label: relationshipLabels[connection.type],
          href: `/ideas/${target.slug}`,
          title: target.title,
          note: connection.note,
          meta: 'Idea',
          draft: target.draft,
        }]
      : [];
  }),
  ...(idea?.incomingConnections ?? []).flatMap((incoming) => {
    const source = ideasBySlug.get(incoming.source);
    return source
      ? [{
          label: inverseRelationshipLabels[incoming.type],
          href: `/ideas/${source.slug}`,
          title: source.title,
          note: incoming.note,
          meta: 'Idea',
          draft: source.draft,
        }]
      : [];
  }),
];

const hasAppearances = sameIdea.length > 0;
const hasContinuations = threadItems.length > 0;
---

{
  (hasAppearances || hasContinuations) && (
    <aside class="shell mt-20" aria-label="Related reading">
      <div class="border-t-2 border-foreground bg-surface px-6 py-12 sm:px-10 sm:py-14">
        <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
          {hasAppearances && (
            <section aria-labelledby="also-appears">
              <h2 id="also-appears" class="t-label text-muted">
                More on this idea
              </h2>
              <ul class="mt-4">
                {sameIdea.map((node) => (
                  <li class="border-t border-rule">
                    <a
                      href={`/writing/${node.slug}`}
                      class="group block py-3.5 no-underline"
                    >
                      <span class="block text-[1.0625rem] leading-snug font-medium text-foreground transition-colors group-hover:text-accent-text">
                        {node.title}
                      </span>
                      <span class="t-label mt-1.5 block text-dim">
                        {node.kind}
                        {node.draft && ' · Draft'}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {hasContinuations && (
            <section aria-labelledby="continue-idea">
              <h2 id="continue-idea" class="t-label text-muted">
                Continue the idea
              </h2>
              <ul class="mt-4">
                {threadItems.map((item) => (
                  <li class="border-t border-rule">
                    <a href={item.href} class="group block py-3.5 no-underline">
                      <span class="t-label block text-accent-text">{item.label}</span>
                      <span class="mt-1.5 block text-[1.0625rem] leading-snug font-medium text-foreground transition-colors group-hover:text-accent-text">
                        {item.title}
                        {item.draft && (
                          <span class="ml-2 align-middle rounded-full bg-accent-fill px-2 py-0.5 text-[0.6rem] text-accent-ink">
                            Draft
                          </span>
                        )}
                      </span>
                      {item.note && (
                        <span class="t-standfirst font-ui mt-1.5 block text-[0.9rem] text-muted">
                          {item.note}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </aside>
  )
}
