---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Page's default colour scheme. Index opens dark, articles open light. */
  theme?: 'dark' | 'light';
  /** Keep thin or placeholder pages out of search indexes. */
  noindex?: boolean;
}

const {
  title,
  description = 'Writing on product strategy, management, operations, measurement, experimentation and AI.',
  theme = 'dark',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={theme} data-default-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=zodiak@700&f[]=sentient@400,500&f[]=satoshi@400,700&display=swap"
    />

    {/* Applies the stored choice before first paint so there is no flash. */}
    <script is:inline>
      (() => {
        try {
          const stored = sessionStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* sessionStorage unavailable - fall back to the page default */
        }
      })();
    </script>
  </head>

  <body>
    <header class="shell flex items-baseline justify-between pt-7 pb-[18px]">
      {/* Framed wordmark; the period uses the inverse accent (red in dark,
          marigold in light). Abbreviates to "PC." on mobile to clear the nav. */}
      <a
        href="/"
        aria-label="Pablo Corzo - home"
        class="inline-block border-2 border-accent-text px-2.5 py-1 font-edo text-[20px] text-foreground no-underline"
      >
        <span aria-hidden="true" class="sm:hidden">Pc</span>
        <span aria-hidden="true" class="hidden sm:inline">Pablo Corzo</span>
      </a>
      <nav class="flex items-center gap-5">
        <a class="t-label no-underline hover:text-foreground" href="/writing">Index</a>
        <a class="t-label no-underline hover:text-foreground" href="/ideas">Ideas</a>
        <a class="t-label no-underline hover:text-foreground" href="/about">About</a>
        <a
          class="t-label rounded-full border border-muted px-4 py-2 no-underline transition-colors hover:border-accent-fill hover:bg-accent-fill hover:text-accent-ink"
          href="mailto:contact@pablocorzo.com"
        >
          Get in touch
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="shell mt-[100px] border-t-2 border-foreground pt-6 pb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
        <p class="t-label">© {new Date().getFullYear()} Pablo Corzo</p>
        <nav class="flex gap-6">
          <a
            class="t-label no-underline transition-colors hover:text-foreground"
            href="mailto:contact@pablocorzo.com"
          >
            Email
          </a>
          <a
            class="t-label no-underline transition-colors hover:text-foreground"
            href="https://linkedin.com/in/pablocorzo"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </nav>
      </div>
    </footer>

    <ThemeToggle />
  </body>
</html>
