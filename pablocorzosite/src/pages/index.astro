---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSiteGraph } from '../utils/site-graph';

// The homepage leads with a curated set — only pieces flagged `featured`.
// The full list lives on /writing. Drafts stay visible in dev, never in prod.
const pieces = (await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft))
  .filter((piece) => piece.data.featured)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// A small set of active ideas — newest development first.
const { graph } = await getSiteGraph();
const featuredIdeas = graph.ideas
  .filter((idea) => idea.artifactCount > 0)
  .sort((a, b) => (b.lastArtifactAt ?? '').localeCompare(a.lastArtifactAt ?? ''))
  .slice(0, 3);
---

<Base title="Pablo Corzo - Writing" theme="dark">
  <section class="shell pt-[52px] pb-[72px]">
    <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr] md:gap-14">
      <div>
        <h1 class="t-display font-edo max-w-[22ch]" style="font-size: clamp(2.75rem, 7vw, 3.375rem)">
          Product observations<span class="text-[var(--accent-alt)]">,</span> written down<span
            class="text-accent-text">.</span
          >
        </h1>
        <p class="t-standfirst font-ui mt-6 max-w-[64ch]">
          This is where I share my thinking and perspective on product leadership, strategy,
          operations, and go-to-market, with a clear focus on experimentation and measurement.
          Everything here is drawn from building products and the operating systems behind them.
          I explore the principles, tradeoffs, and organizational mechanisms that help teams
          move more efficiently while making better-informed decisions.
        </p>
      </div>

      <div class="order-first md:order-none">
        <a
          href="/about"
          aria-label="About Pablo Corzo"
          class="group mx-auto block w-full max-w-[340px] md:mr-0"
        >
          <img
            src="/pablo-headshot.jpg"
            alt="Portrait of Pablo Corzo"
            width="760"
            height="760"
            loading="eager"
            class="block w-full rounded-lg border border-rule transition-opacity duration-150 group-hover:opacity-90"
          />
        </a>
      </div>
    </div>
  </section>

  {
    pieces.length > 0 && (
      <section class="shell pb-16" aria-labelledby="featured-writing">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-accent-fill pb-4">
          <h2 id="featured-writing" class="t-section">Featured</h2>
          <a
            href="/writing"
            class="t-label shrink-0 text-dim no-underline transition-colors hover:text-foreground"
          >
            All writing →
          </a>
        </div>

        <ul>
          {pieces.map((piece) => (
            <li class="group border-b border-rule">
              <a
                href={`/writing/${piece.id}`}
                class="block py-6 no-underline transition-colors duration-150 group-hover:bg-accent-fill md:px-4"
              >
                <span class="t-row-title block group-hover:text-accent-ink">
                  {piece.data.title}
                </span>
                <span class="t-label mt-2 block group-hover:text-accent-ink">
                  {piece.data.kind} / {piece.data.pillar}
                  {piece.data.draft && (
                    <span class="ml-2 rounded-full bg-accent-fill px-2 py-0.5 text-accent-ink">
                      Draft
                    </span>
                  )}
                </span>
                <span class="t-standfirst mt-3 block group-hover:text-accent-ink">
                  {piece.data.deck}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    featuredIdeas.length > 0 && (
      <section class="shell pb-16" aria-labelledby="explore-thinking">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-accent-fill pb-4">
          <h2 id="explore-thinking" class="t-section">Explore the thinking</h2>
          <a
            href="/ideas"
            class="t-label shrink-0 text-dim no-underline transition-colors hover:text-foreground"
          >
            All ideas →
          </a>
        </div>

        <ul class="mt-1">
          {featuredIdeas.map((idea) => (
            <li class="border-b border-rule">
              <a
                href={`/ideas/${idea.slug}`}
                class="group flex flex-col gap-1.5 py-5 no-underline sm:flex-row sm:items-baseline sm:gap-8"
              >
                <span class="block shrink-0 font-edo text-[1.375rem] leading-tight text-foreground transition-colors group-hover:text-accent-text sm:w-[15rem]">
                  {idea.title}
                </span>
                <span class="t-standfirst font-ui block text-[0.95rem] text-body-soft">
                  {idea.statement}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
